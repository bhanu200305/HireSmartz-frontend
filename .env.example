VITE_BACKEND_ENDPOINT=http://your-backend-url
VITE_BACKEND_PREFIX=/api/v1
# Absolute base URL for authentication-service specifically — real login and
# token refresh call this directly (see login.ts / AuthService.ts) rather than
# going through VITE_BACKEND_ENDPOINT above, since that may be pointed at a
# different backend service. Include authentication-service's own prefix.
VITE_AUTH_SERVICE_ENDPOINT=http://your-auth-service-url/api/v1
# Same reasoning as VITE_AUTH_SERVICE_ENDPOINT above, for organization-service:
# every file under src/api/organization-service/** calls this directly via its
# own createApi instance (orgApi.ts) instead of VITE_BACKEND_ENDPOINT. No
# prefix — organization-service mounts its own routes at bare /v1 (no /api
# wrapper), and every endpoint path in src/api/organization-service/**
# already starts with /v1/..., so this must not include one.
VITE_ORG_SERVICE_ENDPOINT=http://your-org-service-url
# Same reasoning as VITE_ORG_SERVICE_ENDPOINT above, for notification-service:
# every file under src/api/notification-service/** calls this directly via
# its own createApi instance (notifApi.ts) instead of VITE_BACKEND_ENDPOINT.
# No prefix — notification-service mounts its own routes at bare /v1 (no
# /api wrapper), same as organization-service.
VITE_NOTIFICATION_SERVICE_ENDPOINT=http://your-notification-service-url
VITE_AGORA_APP_ID=your_agora_app_id
VITE_NYLAS_CLIENT_ID=
VITE_TEMP_TOKEN=your_agora_temp_token
VITE_CHANNEL_NAME=your_channel_name
VITE_INTERVIEW_FEEDBACK_FEATURE=
VITE_VIDEO_CONSENT_FEATURE=

# DEV-ONLY. Set to 'true' in your local .env.local to let the login page accept a
# seeded demo credential (see DEV_SEED_CREDENTIALS in devAuthBypass.ts) and to show
# the DevRoleSwitcher widget, while the backend auth-service isn't available yet.
# The login page itself is always shown first regardless of this flag.
# NEVER set this to true for any shared/deployed environment.
# See src/shared/utils/auth/devAuthBypass.ts
VITE_BYPASS_AUTH=false